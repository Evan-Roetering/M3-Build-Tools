#!/bin/bash

# ============================================= User Input Variables ===============================================

max_cpus=128
partition="scavenger"                   # partition to be used (scavenger or standard) [todo: A100, H100, bigmem]
account="energybio-eng"                 # billing account on cluster
email_address="eroeteri@umd.edu"        # email to send updates to
email_info="all"                        # what should get sent to email (none, begin, end, fail, reque, all)


# ======================================== Check if System Build is Ready ==========================================
if [[ ! -f "./system_build/step5_charmm2gmx.pdb" ]]; then
        echo "ERROR: step5_charmm2gmx.pdb not found in system_build directory"
        exit 1
fi

# =========================================== Check if Inputs Are Valid ============================================
if [[ $partition != "scavenger" && $partition != "standard" ]]; then
        echo "ERROR: ${partition} is not a valid partition, use scavenger or standard"
        exit 1
fi

nodes=$(( (max_cpus + 127) / 128 ))
if (( cores == 1 )); then
        echo "You are about to request ${max_cpus} ${partition} CPU for 3 minimization steps and 5 equilibration steps"
else
        if (( nodes == 1 )); then
                echo "You are about to request ${max_cpus} CPUs across ${nodes} ${partition} node for 3 minimization steps and 5 equilibration steps"
        else
                echo "You are about to request ${max_cpus} CPUs across ${nodes} ${partition} nodes for 3 minimization steps and 5 equilibration steps"
        fi
fi
echo
read -rp "Proceed? [yes/no]: " confirm
if [[ "$confirm" != "yes" ]]; then
        echo "Cancelling Minimization/Equilibration"
        exit 0
fi

#transfer files
cp ./system_build/index.ndx ./min_eq/
cp ./system_build/system.top ./min_eq/
cp ./system_build/step5_charmm2gmx.pdb ./min_eq/
cp -r ./system_build/toppar ./min_eq/
echo $((max_cpus)) > ./min_eq/max_cpus.txt
echo "$partition" > ./min_eq/partition.txt
echo "$account" > ./min_eq/account.txt
echo "$email_address" > ./min_eq/email_address.txt
echo "$email_info" > ./min_eq/email_info.txt

#begin minimization
cd ./min_eq
./step6.0_minimization.sh
