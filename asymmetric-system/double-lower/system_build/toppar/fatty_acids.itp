;;;;; MARTINI 3.0 - Protonated Fatty Acids
;;;;;

; based on deprotonated fatty acids from:
; K.B. Pedersen et al., The Martini 3 Lipidome: Expanded and Refined Parameters Improve Lipid Phase Behavior*,
; ACS Central Science, 2025. doi: 10.1021/acscentsci.5c00755
; P.C.T. Souza et al., Martini 3: A General Purpose Force Field for Coarse-Grained Molecular Dynamics*,
; Nature Methods, 2021. doi: 10.1038/s41592-021-01098-3

; Added by Evan Roetering
; Klauda Lab
; The University of Maryland
; Last Edit - 5/20/2026

;;;;;
;;;;; Linoleic acid - Protonated
;;;;; LAP
;;;;;

;;;;; BEAD-INDEX MAPPING
;;;;; topology description
;
; OOH-C1A-D2A-D3A-C4A    1-2-3-4-5

;@INSANE alhead=OOH, allink=None, altail=CDDC, alname=LAP, charge=0
;@BEADS OOH C1A D2A D3A C4A
;@BONDS OOH-C1A C1A-D2A D2A-D3A D3A-C4A
;


[moleculetype]
LAP     1

[atoms]
; id type   resnr     residu   atom    cgnr charge
1   SP2         1       LAP     OOH     1       0
2   C1          1       LAP     C1A     2       0
3   C4h         1       LAP     D2A     3       0
4   C4h         1       LAP     D3A     4       0
5   C1          1       LAP     C4A     5       0

[bonds]
; i j funct length force.c.
1 2     b_OOH_C1_fa_5long
2 3     b_C1_C4_mid_5long
3 4     b_C4_C4_mid
4 5     b_C1_C4_end

[angles]
 1  2  3        a_OOH_C1_C4_fa
 2  3  4        a_C1_C4_C4_def
 3  4  5        a_C1_C4_C4_def


#ifdef BILAYER_LIPIDHEAD_FC
    [ position_restraints ]
    ;to fix Z postion of head grop in bilayer simulation
      1     1.0      0.0      0.0     BILAYER_LIPIDHEAD_FC
#endif


